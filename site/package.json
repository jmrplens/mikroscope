{
  "name": "mikroscope-docs",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "eslint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "html-validate": "test -n \"$(find dist -name '*.html' -print -quit 2>/dev/null)\" || { echo 'No HTML in dist. Run pnpm build first.' >&2; exit 1; }; html-validate --max-warnings 0 \"dist/**/*.html\"",
    "htmlhint": "test -n \"$(find dist -name '*.html' -print -quit 2>/dev/null)\" || { echo 'No HTML in dist. Run pnpm build first.' >&2; exit 1; }; htmlhint \"dist/**/*.html\"",
    "pa11y": "node scripts/run-pa11y.mjs",
    "a11y:check": "node scripts/check-headings-labels.mjs",
    "anchors:check": "node scripts/check-anchors.mjs",
    "anchors": "node scripts/check-anchors.mjs --write",
    "schema:check": "node scripts/check-structured-data.mjs",
    "directives:check": "node scripts/check-directives.mjs",
    "layout:check": "node scripts/check-layout.mjs",
    "twins:check": "node scripts/check-twins.mjs --only twins",
    "llms:check": "node scripts/check-twins.mjs --only llms",
    "contrast:check": "node scripts/check-contrast.mjs",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "src:check": "node scripts/check-src.mjs",
    "readme:check": "node scripts/check-readme.mjs",
    "version:check": "node scripts/check-version.mjs",
    "voice:check": "node scripts/check-voice.mjs",
    "rsc:check": "node scripts/check-rsc.mjs",
    "grammar:check": "node scripts/check-routeros-grammar.mjs",
    "highlight:check": "node scripts/check-rsc-highlight.mjs",
    "docs": "node scripts/gen-docs.mjs",
    "docs:check": "node scripts/gen-docs.mjs --check",
    "stats": "node scripts/gen-stats.mjs",
    "stats:check": "node scripts/gen-stats.mjs --check",
    "figures": "node scripts/gen-figures.mjs",
    "figures:check": "node scripts/gen-figures.mjs --check",
    "lint": "pnpm run check && pnpm run contrast:check && pnpm run i18n:check && pnpm run src:check && pnpm run readme:check && pnpm run llms:check && pnpm run docs:check && pnpm run rsc:check && pnpm run grammar:check && pnpm run highlight:check && pnpm run stats:check && pnpm run figures:check && pnpm run eslint && pnpm run format:check && pnpm run html-validate && pnpm run htmlhint && pnpm run a11y:check && pnpm run anchors:check && pnpm run schema:check && pnpm run directives:check && pnpm run twins:check && pnpm run version:check && pnpm run voice:check --summary",
    "test:a11y": "pnpm run pa11y",
    "test:generator": "node scripts/check-generator.mjs",
    "analyze": "pnpm run build && pnpm run lint && pnpm run test:a11y",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "@astrojs/starlight": "^0.43.1",
    "astro": "^7.4.12",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "html-validate": "^11.21.1",
    "htmlhint": "^1.9.2",
    "pa11y-ci": "^5.0.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "starlight-links-validator": "^0.27.0",
    "typescript": "^6.0.3",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
