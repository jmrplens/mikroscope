    "prompt-line": {
      "begin": "^([ \\t]*\\[[\\w.+-]+@[^\\]\\r\\n\"\\[]+\\](?:[ \\t]*<SAFE>)?(?:[ \\t]*/[\\w/ .-]*?)?[ \\t]*>)(?:([ \\t]*)(reset-configuration|reset-counters-all|check-for-updates|monitor-traffic|reset-counters|bandwidth-test|apply-changes|make-static|traceroute|shutdown|download|disable|comment|monitor|upgrade|install|release|remove|export|import|enable|reboot|update|cancel|print|unset|reset|start|flush|clear|fetch|torch|renew|blink|find|edit|move|stop|save|load|ping|send|add|set|get|run)(?![\\w=/-]))?",
