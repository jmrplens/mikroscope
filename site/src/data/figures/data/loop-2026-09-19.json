  "queries": {
    "records": "SELECT date_bin(INTERVAL '1 hour', time, TIMESTAMP '2026-09-19T00:00:00Z') AS bin, port, sum(count) AS records FROM mikroscope_kmsg WHERE kind = 'own-address' AND time >= '2026-09-19T11:00:00Z' AND time < '2026-09-24T11:00:00Z' GROUP BY bin, port ORDER BY bin, port",
    "last": "SELECT max(time) AS last FROM mikroscope_kmsg WHERE kind = 'own-address' AND time >= '2026-09-19T11:00:00Z' AND time < '2026-09-24T11:00:00Z'",
    "ports": "SELECT date_bin(INTERVAL '1 hour', time, TIMESTAMP '2026-09-19T00:00:00Z') AS bin, interface, round(avg(rx_pps), 2) AS rx_pps, round(avg(tx_pps), 2) AS tx_pps, count(*) AS readings FROM mikroscope_api_iface WHERE interface IN ('ether2', 'sfp-sfpplus1') AND time >= '2026-09-19T11:00:00Z' AND time < '2026-09-24T11:00:00Z' GROUP BY bin, interface ORDER BY bin, interface",
    "samples": "SELECT date_bin(INTERVAL '1 hour', time, TIMESTAMP '2026-09-19T00:00:00Z') AS bin, count(*) AS samples FROM mikroscope_sample WHERE time >= '2026-09-19T11:00:00Z' AND time < '2026-09-24T11:00:00Z' GROUP BY bin ORDER BY bin",
    "uptime": "SELECT min(time) AS first, max(time) AS last, min(uptime_s) AS up_first, max(uptime_s) AS up_last FROM mikroscope_api_system WHERE time >= '2026-09-19T11:00:00Z' AND time < '2026-09-24T11:00:00Z'",
    "device": "SELECT DISTINCT board, kernel, cores FROM mikroscope_device WHERE time >= '2026-09-19T11:00:00Z' AND time < '2026-09-24T11:00:00Z'"
  },
