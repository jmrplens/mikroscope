---
/**
 * One entry heading of <CampaignRegister> or <VerifiedRegister>, drawn the way
 * Starlight draws a Markdown heading: the wrapper, the heading with its id,
 * and the link to it, named "Section titled “…”" in the page's language, so
 * an entry reads, links and copies like every other heading on the page.
 *
 * Not for pages: a heading a page writes is Markdown, which puts it in the
 * table of contents. These are not, on purpose: a register of twenty entries
 * would bury the page's own sections there.
 */
interface Props {
	id: string;
	level: 3 | 4;
	/** The heading's text, for the link's accessible name. */
	text: string;
}

const { id, level, text } = Astro.props;
const Tag = level === 4 ? "h4" : "h3";
// Starlight's own link icon (@astrojs/starlight, integrations/satteri.js).
const ICON =
	"m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 1 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 0 0-1.42-1.42m8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 1 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 0 0 0 1.42 1 1 0 0 0 1.42 0l3.88-3.89a4.49 4.49 0 0 0 0-6.33M8.83 15.17a1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.92-4.92a1 1 0 1 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42";
const label = Astro.locals.t("heading.anchorLabel", {
	title: text,
	interpolation: { escapeValue: false },
});
---

<div class={`sl-heading-wrapper level-${Tag}`}><Tag id={id}><slot /></Tag><a class="sl-anchor-link" href={`#${id}`}><span aria-hidden="true" class="sl-anchor-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d={ICON} /></svg></span><span class="sr-only" data-pagefind-ignore>{label}</span></a></div>
