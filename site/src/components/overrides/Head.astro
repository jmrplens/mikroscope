---
// Starlight's head, plus everything this site says to machines: one JSON-LD
// `@graph` per page, the Open Graph tags Starlight gets wrong for this site,
// and the links to the page's markdown twin and to the llms.txt indexes.
//
// One graph rather than a scattering of separate scripts, because the nodes
// refer to each other by `@id`: the article is `isPartOf` the website and
// `about` the software, and all three name the same publisher. Split across
// documents those references still resolve, but only for a consumer that
// bothers to merge them.
//
// Ported from ghchronicle's site (src/components/overrides/Head.astro), with
// this project's names, and with two not-found pages instead of one.
// scripts/check-structured-data.mjs reads every property below back out of the
// build, and derives what each one should be from the repository rather than
// from this file.
import { execFileSync } from "node:child_process";
import { existsSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { getCollection } from "astro:content";

import { release } from "../../data/release";
import { PERSON_ID, personNode } from "../../lib/identity.mjs";
import { inBothLanguages, safeJsonLd } from "../../lib/jsonld.mjs";
import {
	BASE,
	NOT_FOUND_ROUTES,
	ORIGIN,
	localeOf,
	pagePath,
	pageUrl,
	routeOf,
	translationRoute,
	twinPath,
	twinUrl,
	withoutLocale,
} from "../../lib/site.mjs";

const REPO = "https://github.com/jmrplens/mikroscope";
const SOFTWARE_ID = `${REPO}#software`;
const SOURCE_ID = `${REPO}#source-code`;
const WEBSITE_ID = `${ORIGIN}${BASE}/#website`;
const MIT = "https://opensource.org/licenses/MIT";

// The day mikroscope was first published: the repository's first commit,
// 95ce1af "mikroscope 1.0.0" (2026-09-16T22:20:21+02:00), and the v1.0.0
// GitHub release, published 2026-09-16T20:45:13Z. The history begins at the
// public release, so there is no earlier date to be had. A constant because it
// is history and cannot change; the schema check holds it to the root commit.
const FIRST_PUBLISHED = "2026-09-16";

// `og:locale` is `language_TERRITORY`, and Starlight writes the bare `lang`
// ("en", "es"). The English pages are written in British English ("licence",
// "behaviour", "colour", "modelled"; the American spellings left in them are
// CSS and command lines), so en_GB rather than the en_US the GEO audit of
// 2026-09-24 suggested. The Spanish pages are written for Spain.
const OG_LOCALE = { en: "en_GB", es: "es_ES" } as const;

// What public/og.png shows, for a reader who cannot see the card. The words
// in the image are English on both sites, so the Spanish text quotes them.
const OG_IMAGE_ALT = {
	en: "The mikroscope mark, a row of amber bars with one tall spike crossing a line, beside the words “mikroscope” and “Sub-second kernel telemetry from inside the router”.",
	es: "La marca de mikroscope, una fila de barras ámbar con un pico alto que cruza una línea, junto al texto en inglés «mikroscope» y «Sub-second kernel telemetry from inside the router».",
} as const;

const entries = await getCollection("docs");
const ENTRY_BY_ROUTE = new Map(entries.map((entry) => [routeOf(entry.id), entry]));

// Routes that resolve to a page that was actually built. A breadcrumb assembles
// one item per path segment, and a segment with no index page linked as an
// `item` points a crawler at a 404, which invalidates the whole trail. Derived
// from the collection so adding a section index later re-links it with no edit
// here. /reference/ and /about/ have no index page today.
const BUILT_ROUTES = new Set(ENTRY_BY_ROUTE.keys());

const route = Astro.url.pathname.slice(BASE.length).replace(/^\/+/, "").replace(/\/+$/, "");
const locale = localeOf(route);
const isHomeRoute = (r: string) => r === "" || r === "es";
const isHome = isHomeRoute(route);
// The two not-found pages, /404.html and /es/404/ (see NOT_FOUND_ROUTES). Each
// carries a canonical pointing at a URL that is not a document, so both are
// marked noindex and get no document node, no breadcrumb and no twin: an error
// page is not a document worth describing.
const isNotFound = NOT_FOUND_ROUTES.has(route);

const starlightRoute = Astro.locals.starlightRoute;
const data = starlightRoute.entry.data;
const title = data.title;
const description = data.description ?? "";
const canonical = pageUrl(route);
const updated = starlightRoute.lastUpdated?.toISOString();

/** The `@id` of a page's document node, the same on the page and on its translation. */
const documentId = (r: string) => `${pageUrl(r)}#${isHomeRoute(r) ? "webpage" : "article"}`;

/**
 * Standard output of one git command, or "" when git is missing, the checkout
 * is not a repository, or the command fails. Every caller treats "" as "not
 * known" and leaves its property out rather than guessing.
 */
function git(args: string[], cwd: string) {
	try {
		return execFileSync("git", args, {
			cwd,
			encoding: "utf8",
			stdio: ["ignore", "pipe", "ignore"],
		}).trim();
	} catch {
		return "";
	}
}

// When this page's file first reached `main`: the committer date of the
// oldest commit that added it, followed across renames (reference/port-names
// began as playbooks/port-names). The committer date rather than the author
// date because `main` takes squash-merged pull requests, and the page was
// published when the merge landed, not when its first draft was written; it is
// also the date Starlight's `lastUpdated` reads, so the two compare. The
// history starts at the public 1.0.0, so a page that has been there since then
// says 2026-09-16.
//
// A shallow clone would answer with its cut-off commit and date every page to
// the day of the build, so there the property is left out, and the schema
// check fails the build for it; docs.yml checks out with `fetch-depth: 0`.
// A page that is not committed yet has no datePublished, though it can have a
// dateModified from the data it renders.
const sourceFile = resolve(process.cwd(), starlightRoute.entry.filePath);
const published = (() => {
	if (isNotFound || !existsSync(sourceFile)) return undefined;
	const cwd = dirname(sourceFile);
	if (git(["rev-parse", "--is-shallow-repository"], cwd) !== "false") return undefined;
	const oldest = git(["log", "--follow", "--diff-filter=A", "--format=%cI", "--", sourceFile], cwd)
		.split("\n")
		.filter(Boolean)
		.at(-1);
	return oldest ? new Date(oldest).toISOString() : undefined;
})();

type SidebarEntry = (typeof starlightRoute.sidebar)[number];

/**
 * The label of the sidebar group that holds the current page, in the page's
 * language: "Collector and sinks" for /sinks/prometheus/, "Colector y
 * destinos" for its twin. The group, not the first path segment, so
 * /reference/testing/ is "For contributors", where the sidebar puts it. A page
 * the sidebar does not list has no section.
 */
function sectionOf(sidebar: SidebarEntry[], group?: string): string | undefined {
	for (const entry of sidebar) {
		if (entry.type === "link" && entry.isCurrent) return group;
		if (entry.type === "group") {
			const found = sectionOf(entry.entries, entry.label);
			if (found) return found;
		}
	}
	return undefined;
}
const section = isHome || isNotFound ? undefined : sectionOf(starlightRoute.sidebar);

// The same page in the other language, when it was built as a page of its own.
// A fallback page (Starlight's English content served at a Spanish URL) is
// not a translation of anything, so it names none and none names it. The node
// is embedded rather than a bare `{"@id": …}`, because that page is a
// different document: a consumer reading only this one still learns its URL,
// language and title.
const counterpartRoute = translationRoute(route);
const counterpartLocale = localeOf(counterpartRoute);
const counterpart =
	isNotFound || starlightRoute.isFallback ? undefined : ENTRY_BY_ROUTE.get(counterpartRoute);
const counterpartNode = counterpart && {
	"@type": isHome ? "WebPage" : "TechArticle",
	"@id": documentId(counterpartRoute),
	...(isHome ? { name: counterpart.data.title } : { headline: counterpart.data.title }),
	url: pageUrl(counterpartRoute),
	inLanguage: counterpartLocale,
};

// The Open Graph image, as astro.config.mjs declares it for every page, so
// the card and the graph cannot name two different files.
type HeadEntry = (typeof starlightRoute.head)[number];
const starlightHead = starlightRoute.head;
const metaContent = (key: string) => {
	const content = starlightHead.find(
		(entry) =>
			entry.tag === "meta" && (entry.attrs?.property === key || entry.attrs?.name === key),
	)?.attrs?.content;
	return typeof content === "string" ? content : undefined;
};
const ogImage = metaContent("og:image");
const ogImageWidth = Number(metaContent("og:image:width"));
const ogImageHeight = Number(metaContent("og:image:height"));
const OG_IMAGE = ogImage
	? {
			"@type": "ImageObject",
			url: ogImage,
			...(ogImageWidth ? { width: ogImageWidth } : {}),
			...(ogImageHeight ? { height: ogImageHeight } : {}),
		}
	: undefined;

const website = {
	"@type": "WebSite",
	"@id": WEBSITE_ID,
	name: "mikroscope",
	url: `${ORIGIN}${BASE}/`,
	description: inBothLanguages({
		en: "Documentation for mikroscope: installing the agent on a RouterOS device, what it costs the router, what it reads from the kernel, and where the collector sends it.",
		es: "Documentación de mikroscope: cómo instalar el agente en un equipo RouterOS, lo que le cuesta al router, lo que lee del kernel y adónde lo envía el colector.",
	}),
	inLanguage: ["en", "es"],
	...(OG_IMAGE ? { image: OG_IMAGE } : {}),
	publisher: { "@id": PERSON_ID },
	about: { "@id": SOFTWARE_ID },
};

const software = {
	"@type": "SoftwareApplication",
	"@id": SOFTWARE_ID,
	name: "mikroscope",
	// The name is shared with an unrelated npm package and is one letter from
	// a common word, so the node says which mikroscope it is three ways: the
	// owner/name every registry and `docker pull` uses, the qualified name the
	// GEO audit of 2026-09-24 proposed, and `disambiguatingDescription`.
	alternateName: ["jmrplens/mikroscope", "mikroscope for MikroTik RouterOS"],
	applicationCategory: "DeveloperApplication",
	applicationSubCategory: "Network monitoring",
	// What .goreleaser.yaml builds: the CLI for Linux, macOS, Windows and
	// FreeBSD; the agent for Linux only, and it is meant to run in a container
	// on RouterOS 7 (arm64, arm, x86_64), where it reads the router's kernel.
	operatingSystem:
		"CLI: Linux, macOS, Windows, FreeBSD. Agent: Linux, in a RouterOS 7 container (arm64, arm, x86_64).",
	// What install/prerequisites says a router needs before `install` can write
	// anything, and what the host running the CLI needs. The check holds the
	// RouterOS floor here to the one that page states, in both languages.
	softwareRequirements: inBothLanguages({
		en: "Agent: RouterOS 7.24 or later on arm64, 32-bit ARM or x86_64 (not MIPS or TILE), with the container package enabled and device-mode container=yes, which needs a button press or a power cycle at the router. CLI installs: ssh to the router with a key or an ssh agent.",
		es: "Agente: RouterOS 7.24 o posterior en arm64, ARM de 32 bits o x86_64 (ni MIPS ni TILE), con el paquete container activado y device-mode container=yes, que exige pulsar un botón o apagar y encender el router. Instalar con la CLI: ssh al router con una clave o un agente ssh.",
	}),
	url: REPO,
	// Where the same software is published, each checked on 2026-09-24 against
	// a control name that does not exist: the Go module on pkg.go.dev, the
	// agent and collector images on Docker Hub (read through its v2 API,
	// because hub.docker.com/r/ answers 200 for any name) and on GHCR.
	sameAs: [
		"https://pkg.go.dev/github.com/jmrplens/mikroscope",
		"https://hub.docker.com/r/jmrplens/mikroscope-agent",
		"https://hub.docker.com/r/jmrplens/mikroscope",
		"https://github.com/jmrplens/mikroscope/pkgs/container/mikroscope-agent",
		"https://github.com/jmrplens/mikroscope/pkgs/container/mikroscope",
	],
	// VERSION, through src/data/release.ts: what internal/version stamps into
	// both binaries and what a `v*` tag publishes. It was a hand-typed "1.0.0"
	// here through eleven releases.
	softwareVersion: release.version,
	// The release page of that tag. docs.yml deploys on the push that bumps
	// VERSION and the tag is pushed by hand after it (.github/RELEASING.md),
	// so for the minutes between the two this URL is ahead of GitHub; for
	// 1.2.2 the tag followed the merge by 3 s, well inside the site's build.
	// /releases would never be ahead, and would name no version.
	releaseNotes: release.notesUrl,
	datePublished: FIRST_PUBLISHED,
	// The releases page rather than one asset: .goreleaser.yaml publishes an
	// archive per platform, four agent image tars and the images on Docker Hub
	// and GHCR, and no single URL names the one a given reader wants.
	downloadUrl: `${REPO}/releases/latest`,
	installUrl: pageUrl("install"),
	softwareHelp: { "@type": "CreativeWork", url: `${ORIGIN}${BASE}/` },
	description: inBothLanguages({
		en: "Sub-second kernel telemetry from inside a MikroTik router, with the cost of the observer measured rather than claimed.",
		es: "Telemetría de kernel por debajo del segundo desde dentro de un router MikroTik, con el coste del observador medido y no prometido.",
	}),
	disambiguatingDescription: inBothLanguages({
		en: "The kernel-telemetry tool for MikroTik routers published at github.com/jmrplens/mikroscope: a Go agent that runs in a RouterOS container and reads the router's kernel counters, and a CLI that installs it, records and forwards what it reads. Not a microscope, and not related to other software named mikroscope.",
		es: "La herramienta de telemetría de kernel para routers MikroTik publicada en github.com/jmrplens/mikroscope: un agente en Go que corre en un contenedor de RouterOS y lee los contadores del kernel del router, y una CLI que lo instala, graba y reenvía lo que lee. No es un microscopio ni tiene relación con otro software llamado mikroscope.",
	}),
	// What it is about, as Wikidata names it, so a consumer that knows those
	// entities can place it without parsing the prose. Each id was read back
	// from Wikidata's entity data on 2026-09-24.
	about: [
		{ "@type": "Thing", name: "MikroTik", sameAs: "https://www.wikidata.org/wiki/Q913580" },
		{ "@type": "Thing", name: "RouterOS", sameAs: "https://www.wikidata.org/wiki/Q12036888" },
		{ "@type": "Thing", name: "Linux kernel", sameAs: "https://www.wikidata.org/wiki/Q14579" },
	],
	keywords:
		"MikroTik, RouterOS, kernel telemetry, /proc, container, Prometheus, InfluxDB, Grafana, observability, Go",
	license: MIT,
	isAccessibleForFree: true,
	offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
	...(OG_IMAGE ? { image: OG_IMAGE } : {}),
	author: { "@id": PERSON_ID },
	// The three agents the sibling sites emit for a project of this account, so
	// the merged node states one consistent set instead of a partial one per
	// document.
	creator: { "@id": PERSON_ID },
	maintainer: { "@id": PERSON_ID },
};

const sourceCode = {
	"@type": "SoftwareSourceCode",
	"@id": SOURCE_ID,
	name: "mikroscope source code",
	codeRepository: REPO,
	programmingLanguage: {
		"@type": "ComputerLanguage",
		name: "Go",
		url: "https://go.dev/",
		sameAs: "https://www.wikidata.org/wiki/Q37227",
	},
	// No `runtimePlatform`. schema.org defines it as "runtime platform or
	// script interpreter dependencies (example: Java v1, Python 2.3, .NET
	// Framework 3.0)", and both binaries are built with CGO_ENABLED=0: they
	// need no runtime and no interpreter. "Go" there said the opposite, and
	// the platforms they run on are `operatingSystem` on the software, which
	// `targetProduct` names.
	targetProduct: { "@id": SOFTWARE_ID },
	// The code about/lineage.mdx says was taken, not modelled: the deployment
	// steps, image builder, chart and RouterOS API client from
	// cs-routeros-bouncer, whose own site gives its source code this `@id`, and
	// the upstream that client is a pruned vendoring of, at the tag it was
	// taken from.
	isBasedOn: [
		{
			"@type": "SoftwareSourceCode",
			"@id": "https://github.com/jmrplens/cs-routeros-bouncer#source-code",
			name: "cs-routeros-bouncer source code",
			codeRepository: "https://github.com/jmrplens/cs-routeros-bouncer",
			license: MIT,
		},
		{
			"@type": "SoftwareSourceCode",
			name: "go-routeros",
			codeRepository: "https://github.com/go-routeros/routeros",
			version: "3.0.1",
			license: MIT,
		},
	],
	license: MIT,
	author: { "@id": PERSON_ID },
	creator: { "@id": PERSON_ID },
	maintainer: { "@id": PERSON_ID },
};

// The page itself: a TechArticle for a documentation page, a WebPage for the
// two landings, which are a summary of the project rather than an article
// about it. Without one, the site's two most important URLs would have no
// document node for `isPartOf`, `about` or the twin announcement to hang on.
const document = isNotFound
	? null
	: {
			"@type": isHome ? "WebPage" : "TechArticle",
			"@id": documentId(route),
			...(isHome ? { name: title } : { headline: title }),
			...(description ? { description } : {}),
			url: canonical,
			mainEntityOfPage: canonical,
			// A landing is about one thing, the software, so it is the landing's
			// main entity as well as its subject.
			...(isHome ? { mainEntity: { "@id": SOFTWARE_ID } } : {}),
			...(section ? { articleSection: section } : {}),
			inLanguage: locale,
			...(OG_IMAGE ? { image: OG_IMAGE } : {}),
			// The same page as markdown, which is what the <link rel="alternate">
			// below announces to a browser. A consumer reading the graph gets the
			// cheap representation without having to parse the expensive one first.
			encoding: {
				"@type": "MediaObject",
				encodingFormat: "text/markdown",
				contentUrl: twinUrl(route),
			},
			...(published ? { datePublished: published } : {}),
			...(updated ? { dateModified: updated } : {}),
			// English pages are the source and Spanish ones the translation, which
			// is the direction schema.org gives the two properties.
			...(counterpartNode
				? { [locale === "es" ? "translationOfWork" : "workTranslation"]: counterpartNode }
				: {}),
			author: { "@id": PERSON_ID },
			publisher: { "@id": PERSON_ID },
			isPartOf: { "@id": WEBSITE_ID },
			about: { "@id": SOFTWARE_ID },
		};

/**
 * The locale-free route a sidebar link points at, "sinks/prometheus" for both
 * /mikroscope/sinks/prometheus/ and /mikroscope/es/sinks/prometheus/.
 *
 * @param href a sidebar link's href, base and locale included
 */
function linkRoute(href: string) {
	return withoutLocale(href.slice(BASE.length).replace(/^\/+|\/+$/g, ""));
}

/**
 * The label for one path segment, taken from the sidebar group that owns it,
 * so a Spanish trail reads in Spanish and a renamed group is renamed here too.
 * The route's sidebar is the public, already translated form of the sidebar
 * configuration. A segment no group claims is title cased from the slug.
 *
 * @param segment one path segment, or "" for the site root
 */
function segmentLabel(segment: string) {
	if (segment === "") return Astro.locals.t("ms.breadcrumb.home");
	const group = starlightRoute.sidebar.find(
		(entry) =>
			entry.type === "group" &&
			entry.entries.some((item) => {
				if (item.type !== "link" || !item.href.startsWith(`${BASE}/`)) {
					return false;
				}
				const route = linkRoute(item.href);
				return route === segment || route.startsWith(`${segment}/`);
			}),
	);
	return group?.label ?? segment.replace(/-/g, " ").replace(/^./, (c) => c.toUpperCase());
}

const breadcrumb =
	isHome || isNotFound
		? null
		: {
				"@type": "BreadcrumbList",
				"@id": `${canonical}#breadcrumb`,
				itemListElement: [
					{
						"@type": "ListItem",
						position: 1,
						name: segmentLabel(""),
						item: `${ORIGIN}${pagePath(locale === "es" ? "es" : "")}`,
					},
					...(() => {
						const segments = route.split("/").filter((s) => s !== "es");
						let accumulated = locale === "es" ? "es" : "";
						return segments.map((segment, index) => {
							accumulated = accumulated ? `${accumulated}/${segment}` : segment;
							const last = index === segments.length - 1;
							return {
								"@type": "ListItem",
								position: index + 2,
								name: last ? title : segmentLabel(segment),
								// A ListItem with a name and no `item` is the documented form
								// for a level that is not a link, which is what a section with
								// no index page is.
								...(last || BUILT_ROUTES.has(accumulated)
									? { item: `${ORIGIN}${pagePath(accumulated)}` }
									: {}),
							};
						});
					})(),
				],
			};

const graph = {
	"@context": "https://schema.org",
	"@graph": [
		// The canonical Person, fetched at build time. Spliced verbatim so this
		// site and jmrp.io describe the same node with the same values instead of
		// two hand-kept copies that drift.
		await personNode(),
		website,
		software,
		sourceCode,
		...(document ? [document] : []),
		...(breadcrumb ? [breadcrumb] : []),
	],
};

// Starlight's Open Graph tags, corrected where they are wrong for this site
// and completed where they stop short:
//   - `og:locale` in the language_TERRITORY form the protocol asks for, and
//     `og:locale:alternate` naming the translation where one was built;
//   - `og:type` "website" on the two landings, which are not articles;
//   - the image's alternative text, for Open Graph and for the X card;
//   - on an article, its section and dates, the same values the graph states.
// A new array rather than a write into route data: routeMiddleware.ts is
// where this project changes route data, and nothing after the head reads it.
const meta = (property: string, content: string): HeadEntry => ({
	tag: "meta",
	attrs: { property, content },
});
const articleMeta: HeadEntry[] =
	document && !isHome
		? [
				...(published ? [meta("article:published_time", published)] : []),
				...(updated ? [meta("article:modified_time", updated)] : []),
				...(section ? [meta("article:section", section)] : []),
			]
		: [];
const head = starlightHead.flatMap((entry): HeadEntry[] => {
	if (entry.tag !== "meta") return [entry];
	switch (entry.attrs?.property ?? entry.attrs?.name) {
		case "og:locale":
			return [
				{ ...entry, attrs: { ...entry.attrs, content: OG_LOCALE[locale] } },
				...(counterpartNode ? [meta("og:locale:alternate", OG_LOCALE[counterpartLocale])] : []),
			];
		case "og:type":
			return isHome
				? [{ ...entry, attrs: { ...entry.attrs, content: "website" } }]
				: [entry, ...articleMeta];
		case "og:image":
			return [entry, meta("og:image:alt", OG_IMAGE_ALT[locale])];
		case "twitter:image":
			return [
				entry,
				{ tag: "meta", attrs: { name: "twitter:image:alt", content: OG_IMAGE_ALT[locale] } },
			];
		default:
			return [entry];
	}
});

const llmsPath = locale === "es" ? `${BASE}/es/llms.txt` : `${BASE}/llms.txt`;
const llmsFullPath = locale === "es" ? `${BASE}/es/llms-full.txt` : `${BASE}/llms-full.txt`;
// The core bundle beside the full one: a tool that stops reading the full
// file partway still finds the pages a first answer needs (src/lib/llms.mjs).
const llmsCorePath = locale === "es" ? `${BASE}/es/llms-core.txt` : `${BASE}/llms-core.txt`;
---

{
	/* What Starlight's own Head.astro renders (0.42.2), from the array above. */
	head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)
}

{isNotFound && <meta name="robots" content="noindex, follow" />}
<script type="application/ld+json" is:inline set:html={safeJsonLd(graph)} />
{!isNotFound && <link rel="alternate" type="text/markdown" href={twinPath(route)} title={title} />}
<link rel="alternate" type="text/plain" href={llmsPath} title="llms.txt" />
<link rel="alternate" type="text/plain" href={llmsCorePath} title="llms-core.txt" />
<link rel="alternate" type="text/plain" href={llmsFullPath} title="llms-full.txt" />
