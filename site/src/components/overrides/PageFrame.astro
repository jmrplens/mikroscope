---
/**
 * Starlight's page frame, with the drawer and its button on every page.
 *
 * Starlight builds the sidebar drawer, and the button that opens it, only
 * where the route `hasSidebar`, which a `splash` page does not. The landing is
 * the page most likely to be someone's first, and without this it would be the
 * one page with no way into the documentation except the hero's buttons.
 *
 * This is a copy of Starlight 0.42.0's PageFrame with the condition moved: the
 * drawer is rendered on every page, and only the rule that turns it into a
 * permanent column at `md` stays behind `[data-has-sidebar]`. The landing
 * keeps its full width and gains the same button, in the same corner, opening
 * the same drawer. Routing the splash through a sidebar instead (setting
 * `hasSidebar` in route data) would make it a two-column page at `md`, and this
 * site's sidebar is a real tree that the landing should not sit beside.
 *
 * It is a copy, not a wrapper, because the condition is inside the markup; the
 * two rules that differ from the original are marked CHANGED.
 */
// The virtual paths, as Starlight's own PageFrame imports them, so a future
// override of either reaches the splash drawer too; src/env.d.ts declares the
// modules for `astro check`.
import MobileMenuToggle from "virtual:starlight/components/MobileMenuToggle";
import Sidebar from "virtual:starlight/components/Sidebar";

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page sl-flex">
	<header class="header"><slot name="header" /></header>
	<nav class="sidebar print:hidden" aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}>
		<MobileMenuToggle />
		<script>
			// The mobile menu uses the popover API to open and close without JavaScript. We enhance this
			// behaviour with focus trapping while the menu is open.
			class StarlightSidebarPane extends HTMLElement {
				constructor() {
					super();

					// Close the menu when the viewport is resized between mobile and desktop sizes.
					matchMedia("(min-width: 50em)").addEventListener("change", () => this.hidePopover());

					// Update the menu state when the sidebar popover is toggled.
					this.addEventListener("toggle", ({ newState }) => this.trapFocus(newState === "open"));
				}
				/** Trap keyboard focus inside the header and menu when the menu is expanded. */
				trapFocus(shouldTrap: boolean) {
					document.querySelectorAll<HTMLElement>(".main-frame, .sl-skip-link").forEach((el) => {
						el.toggleAttribute("inert", shouldTrap);
					});
				}
			}
			customElements.define("sl-sidebar-pane", StarlightSidebarPane);
		</script>
		<sl-sidebar-pane popover="" id="starlight__sidebar" class="sidebar-pane">
			<div class="sidebar-content sl-flex">
				{/* Page.astro fills the slot only where the route has a sidebar. */}
				{hasSidebar ? <slot name="sidebar" /> : <Sidebar />}
			</div>
		</sl-sidebar-pane>
	</nav>
	<div class="main-frame"><slot /></div>
</div>

{/*
	The sidebar is a real tree — eleven groups, forty-odd links — and it is
	taller than its own scroller, so on a page low in the tree the entry for the
	page you are reading starts below the fold and the column looks like it is
	showing someone else's section. This scrolls the current entry into view
	inside the sidebar, and only inside it: `scrollIntoView` would otherwise
	move the page as well, which on a doc page means landing below the title.
*/}
<script is:inline>
	(() => {
		const link = document.querySelector('#starlight__sidebar a[aria-current="page"]');
		if (!link) return;
		const scroller = link.closest(".sidebar-content") || link.closest("#starlight__sidebar");
		if (!scroller || scroller.scrollHeight <= scroller.clientHeight) return;
		const top = link.offsetTop - scroller.clientHeight / 2 + link.offsetHeight / 2;
		scroller.scrollTop = Math.max(0, top);
	})();
</script>

<style>
	/* Starlight's frame styles, repeated rather than inherited: they are scoped
	 * to the component this replaces, so they do not come with it. */
	@layer starlight.core {
		.page {
			flex-direction: column;
			min-height: 100vh;
		}

		.header {
			z-index: var(--sl-z-index-navbar);
			position: fixed;
			inset-inline-start: 0;
			inset-block-start: 0;
			width: 100%;
			height: var(--sl-nav-height);
			border-bottom: 1px solid var(--sl-color-hairline-shade);
			padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
			background-color: var(--sl-color-bg-nav);
		}

		/* CHANGED: the original reserves the menu button's corner only on a page
		 * with a sidebar. Every page has the button now, so the corner is reserved
		 * everywhere and given back at `md` only where the sidebar becomes a
		 * column and the button leaves the screen. */
		.header {
			padding-inline-end: calc(var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size));
		}

		@media (min-width: 50rem) {
			:global([data-has-sidebar]) .header {
				padding-inline-end: var(--sl-nav-pad-x);
			}
		}

		.sidebar-pane {
			/* By default, user agents apply some opinionated styles to popovers, which we don’t want. */
			border: unset;
			padding: unset;
			height: unset;
			color: unset;

			position: fixed;
			z-index: var(--sl-z-index-menu);
			inset-block: var(--sl-nav-height) 0;
			inset-inline-start: 0;
			width: 100%;
			background-color: var(--sl-color-black);
			overflow-y: auto;
			scrollbar-gutter: stable;
		}

		.sidebar-content {
			height: 100%;
			min-height: max-content;
			padding: 1rem var(--sl-sidebar-pad-x) 0;
			flex-direction: column;
			gap: 1rem;
		}

		@media (min-width: 50rem) {
			.sidebar-content::after {
				content: "";
				padding-bottom: 1px;
			}
		}

		.main-frame {
			padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
			padding-inline-start: var(--sl-content-inline-start);
		}

		@media (min-width: 50rem) {
			/* CHANGED: the drawer becomes a permanent column only where the route
			 * has a sidebar. On the splash it stays a closed popover, which is what
			 * keeps the landing full width. */
			:global([data-has-sidebar]) .sidebar-pane {
				display: block;
				width: var(--sl-sidebar-width);
				background-color: var(--sl-color-bg-sidebar);
				border-inline-end: 1px solid var(--sl-color-hairline-shade);
			}

			/* CHANGED: the splash keeps the drawer as a popover past `md`, and the
			 * mobile rule above makes that popover the viewport's width. At 1280 px
			 * each group's collapse caret sat about 1100 px from its label, across
			 * an empty sheet (measured 2026-09-15, headless Chromium). Past `md` it
			 * is the same column a doc page shows, laid over the landing. */
			:global(html:not([data-has-sidebar])) .sidebar-pane {
				width: var(--sl-sidebar-width);
				background-color: var(--sl-color-bg-sidebar);
				border-inline-end: 1px solid var(--sl-color-hairline-shade);
			}
			/* The landing beside the column is inert, so it is dimmed to say so; the
			 * header is left clear, because the button that closes the drawer is in it. */
			:global(html:not([data-has-sidebar])) .sidebar-pane::backdrop {
				inset-block-start: var(--sl-nav-height);
				background-color: color-mix(in srgb, var(--ms-page) 60%, transparent);
			}
		}
	}
</style>

<style is:global>
	/* md:sl-hidden sits in @layer starlight.utils, which outranks starlight.core;
	 * only unlayered wins. A page with no sidebar column keeps its button past
	 * `md`, because the button is its only way into the drawer. `screen`, because
	 * unlayered also beats `print:hidden`, and a US Letter page is 816 px wide:
	 * without it the fixed button printed on the landing. */
	@media screen and (min-width: 50rem) {
		html:not([data-has-sidebar]) .sl-menu-button {
			display: flex;
		}
		/* MobileMenuToggle gives the page its scroll back at `md`, because there
		 * the drawer is a column on every page Starlight knows. On the splash it is
		 * still an open popover over an inert landing, and the wheel scrolled the
		 * landing behind it (body overflow measured `auto` at 1280 px). */
		html:not([data-has-sidebar]) body:has(#starlight__sidebar:popover-open) {
			overflow: hidden;
		}
	}

	/* The menu button as a bare icon, like the theme toggle and the globe beside
	 * it. Starlight's is a filled disc with a shadow, which in the dark theme was
	 * the brightest thing in the header, brighter than the wordmark. Unlayered, so
	 * it wins over the light-theme rule inside `@layer starlight.core`. */
	.sl-menu-button {
		border-radius: var(--ms-radius);
		background-color: transparent;
		color: var(--sl-color-gray-2);
		box-shadow: none;
	}
	.sl-menu-button:hover,
	.sl-menu-button:has(~ :popover-open) {
		background-color: var(--ms-surface);
		color: var(--sl-color-white);
	}
	.sl-menu-button:focus-visible {
		outline: 2px solid var(--ms-accent);
		outline-offset: 2px;
	}
</style>
