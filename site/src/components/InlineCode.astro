---
/**
 * One inline `<code>` from a data string, with the same break rules markdown
 * code gets from src/lib/inline-code.mjs: short code on one line, a flag's
 * dashes kept with its name, a long name breakable only after `_`, `/`, `.`.
 * Without it the doctor checks on reference/cli rendered `--memory-max` as
 * "-" / "-memory-max" at 390 px (2026-09-15), because the markdown plugin
 * never sees code a component renders.
 *
 * Short code is drawn as a unit, `.ms-code-unit`, with `before` and `after`,
 * the characters that touch it in the string it came from (codeRuns, used by
 * <CodeText>); inline-code.mjs says why. `unit={false}` leaves the unit to the
 * page: <Src> is written inline in MDX, where the markdown plugin draws the
 * unit around the whole link and the punctuation beside it.
 */
import { inlineCodeParts, keepClass } from "../lib/inline-code.mjs";

interface Props {
	text: string;
	class?: string;
	before?: string;
	after?: string;
	unit?: boolean;
}

const { text, class: extra, before = "", after = "", unit = true } = Astro.props;
const { nowrap, parts } = inlineCodeParts(text);
const className = [extra, nowrap ? "ms-code-nowrap" : undefined].filter(Boolean).join(" ") || undefined;
---

{
	nowrap && unit ? (
		<span class="ms-code-unit">{before}<code class={className}>{text}</code>{after}</span>
	) : (
		<Fragment>{before}<code class={className}>{parts.map((p) => (p.kind === "wbr" ? <wbr /> : p.kind === "keep" ? <span class={keepClass(p)}>{p.value}</span> : p.value))}</code>{after}</Fragment>
	)
}
