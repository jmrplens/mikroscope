---
/**
 * Where and when a yes-or-no RouterOS fact was checked, inline, from
 * src/data/verifications.ts: "RB5009UG+S+, RouterOS 7.24.2, 2026-09-11".
 *
 * The verb stays in the page's sentence ("verified on …", "verificado en …"),
 * which is where the fact itself is said. Each segment is a nowrap span, as in
 * Provenance, so a phone wraps between them and never inside "RouterOS 7.24.2".
 * Everything is on one line of output: a break inside an inline element is a
 * space before the punctuation that follows it.
 *
 * Evidence pages only (src/lib/voice.mjs): anywhere else it warns, or fails
 * the build once MS_VOICE is "error". A guide states the fact and links it:
 * <TestedOn of="<fact>">verified</TestedOn> points at the fact's entry in
 * <VerifiedRegister> on Tested on.
 */
import { isVerificationId, verifications } from "../data/verifications";
import { evidenceOnly } from "../lib/voice.mjs";

interface Props {
	of: string;
}

const { of } = Astro.props;
if (!isVerificationId(of)) {
	throw new Error(`Verified: unknown fact "${of}"; facts live in src/data/verifications.ts`);
}
evidenceOnly("<Verified>", Astro.locals.starlightRoute);
const v = verifications[of];
---

<span class="ms-verified" data-verified={of}><span class="ms-verified-fact">{v.device}</span>, <span class="ms-verified-fact">RouterOS {v.routeros}</span>, <time class="ms-verified-fact" datetime={v.date}>{v.date}</time></span>
