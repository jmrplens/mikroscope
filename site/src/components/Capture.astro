---
/**
 * One screenshot of the dashboard, inline, where the prose needs a picture of
 * a single thing rather than the section-by-section set `DashboardCaptures`
 * lays out.
 *
 * The file comes from the same generator, `gen-dashboard-captures.mjs`, over
 * the same demonstration database the end-to-end suite's fake agent fills, so
 * nothing about a real router is in it. The caption and the alt text are the
 * page's, because they say what THIS picture is being shown for, and that
 * differs per page and per language.
 *
 * Responsive the same way as DashboardCaptures.astro, with the same widths and
 * `sizes`: `<Image>` writes a 640, a 1024 and a 1600 px variant, the browser
 * picks one, and the link opens the committed 1600 px file.
 */
import { Image } from "astro:assets";

interface Props {
	/** The file stem under src/assets/dashboards, e.g. `annotations`. */
	name: string;
	/** What a reader who cannot see the image needs to know it shows. */
	alt: string;
	/** The line under it. */
	caption: string;
}

const { name, alt, caption } = Astro.props as Props;

const images = import.meta.glob<{ default: ImageMetadata }>(
	"../assets/dashboards/*.webp",
	{ eager: true },
);
const key = Object.keys(images).find((f) => f.endsWith(`/${name}.webp`));
if (!key) {
	throw new Error(
		`<Capture name="${name}" />: no ${name}.webp in src/assets/dashboards. See the header of site/scripts/gen-dashboard-captures.mjs.`,
	);
}
const image = images[key].default;

/** The variants written for `srcset`; the largest is the committed file's own width. */
const WIDTHS = [640, 1024, 1600];
/** At most the prose column (`--sl-content-width`, 50rem in chrome.css), else the viewport. */
const SIZES = "(min-width: 50rem) 50rem, 100vw";
---

<figure class="ms-capture ms-capture-single">
	<a href={image.src}>
		<Image
			src={image}
			widths={WIDTHS}
			sizes={SIZES}
			width={image.width}
			height={image.height}
			loading="lazy"
			decoding="async"
			alt={alt}
		/>
	</a>
	<figcaption>{caption}</figcaption>
</figure>

<style>
	/* The border, radius, width and caption come from `.ms-capture` in
	 * components.css. What differs is the height: that rule caps a section
	 * thumbnail at 30rem and crops the rest, and a single picture shown for
	 * what is in it, down to the tile in its bottom corner, is shown whole.
	 * Both selectors name the two classes so they outrank that rule wherever
	 * the stylesheets land in the page. */
	.ms-capture.ms-capture-single {
		margin-block: 1.5rem;
	}
	.ms-capture.ms-capture-single :global(img) {
		max-block-size: none;
	}
</style>
