---
/**
 * A data string with `backtick` code spans, rendered as text and real `<code>`.
 *
 * The data files keep a flag or a path in backticks so that one string serves
 * both a table cell and a sentence; this turns it into markup without
 * `set:html`, which the MDX pipeline here mangles (astro.config.mjs). Each
 * short code is drawn as a unit with the punctuation that touches it
 * (codeRuns in src/lib/inline-code.mjs).
 */
import { codeRuns } from "../lib/inline-code.mjs";
import InlineCode from "./InlineCode.astro";

interface Props {
	text: string;
}

const { text } = Astro.props;
---

{codeRuns(text).map((p) => (p.kind === "code" ? <InlineCode text={p.value} before={p.before} after={p.after} /> : p.value))}
