---
/**
 * The "how to recognise it" list of a playbook, with how the fault came about.
 *
 * Every fault page reads differently depending on whether the data is a real
 * fault found in production, a fault provoked on purpose, or something the
 * router does on its own. The page says so in its first paragraph; by the
 * signature, a reader who jumped straight to it has lost that. So the block
 * carries it again, as a legend word and a date, and `data-origin` makes the
 * three kinds countable, as `data-claim` does for NotClaimed.
 *
 * `origin` and `date` are provenance, so they belong on the case studies
 * (src/lib/voice.mjs): on any other page they warn, or fail the build once
 * MS_VOICE is "error". Both are optional. Without them the block is the
 * signature alone, which is what Diagnose faults shows for a fault whose case
 * study it links to.
 *
 * The "## The signature" heading stays authored in the page, above this block,
 * so it keeps its table-of-contents line and its anchor.
 */
import { evidenceOnly } from "../lib/voice.mjs";

const ORIGINS = {
	real: "ms.fault.real",
	provoked: "ms.fault.provoked",
	unprovoked: "ms.fault.unprovoked",
} as const;

interface Props {
	origin?: keyof typeof ORIGINS;
	/** ISO date the data was taken. */
	date?: string;
}

const { origin, date } = Astro.props;
if (origin !== undefined && !Object.hasOwn(ORIGINS, origin)) {
	throw new Error(
		`FaultSignature: unknown origin "${origin}"; use ${Object.keys(ORIGINS)
			.map((o) => `"${o}"`)
			.join(", ")}`,
	);
}
if (date !== undefined && !/^\d{4}-\d{2}-\d{2}$/.test(date)) {
	throw new Error(`FaultSignature: date must be an ISO date (YYYY-MM-DD), got "${date}"`);
}
if (origin !== undefined) evidenceOnly("<FaultSignature origin>", Astro.locals.starlightRoute);
if (date !== undefined) evidenceOnly("<FaultSignature date>", Astro.locals.starlightRoute);
const legend = origin === undefined ? undefined : Astro.locals.t(ORIGINS[origin]);
---

<div class="ms-fault" data-origin={origin}>
	{
		(legend !== undefined || date !== undefined) && (
			<p class="ms-fault-legend">
				{legend}{legend !== undefined && date !== undefined && " · "}{date !== undefined && <time datetime={date}>{date}</time>}
			</p>
		)
	}
	<slot />
</div>
