---
/**
 * The landing's first block: four measured figures, each a link to the page
 * that explains it, and the one paragraph that says what they are.
 *
 * The numbers are the headline, so what they measure sits directly under
 * them, in the same section, including the fact that the 10 Hz CPU figure is
 * over budget. The device, the RouterOS version and the date are on Tested
 * on, which that paragraph links (src/lib/voice.mjs: the landing is a guide).
 */
import { measurements } from "../../data/measurements";
import { gapsDrops, type HomeContent } from "../../data/home";
import { formatQuantity } from "../../lib/format";
import { langOf } from "../../lib/lang";
import { codeInHtml } from "../../lib/inline-code.mjs";
import { valuesInHtml } from "../../lib/nowrap-values.mjs";

interface Props {
	readout: HomeContent["readout"];
	headingId: string;
}

const { readout, headingId } = Astro.props;
const lang = langOf(Astro.locals.starlightRoute);
const value = (id: HomeContent["readout"]["items"][number]["id"]) =>
	id === "run.gapsDrops" ? gapsDrops(lang) : formatQuantity(measurements[id], lang);
---

<h2 id={headingId}>{readout.title}</h2>
<div class="ms-readout">
	{
		readout.items.map((item) => (
			<a class="ms-readout-item" href={item.href}>
				<span class="ms-readout-value">{value(item.id)}</span>
				<span class="ms-readout-label">{item.label}</span>
			</a>
		))
	}
</div>
<p class="ms-readout-claim" set:html={valuesInHtml(codeInHtml(readout.claim))} />
