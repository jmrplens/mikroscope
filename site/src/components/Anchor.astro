---
/**
 * A heading id kept alive after its heading changed.
 *
 * `<Anchor name="old-id" />` renders `<span id="old-id" data-anchor-alias>`,
 * so a link, a bookmark or an answer elsewhere that names the old id still
 * lands on the section. Put it on the line right before the heading that took
 * the section over (a merged or repurposed section), or, where a section left
 * the page, at the nearest related spot with one sentence linking to its new
 * home. A heading that was only relabelled keeps its id with `{#old-id}`
 * instead, which needs no component.
 *
 * scripts/check-anchors.mjs counts these ids as present, so the published id
 * in scripts/anchors.txt stays listed. The prop is `name`, not `id`: the
 * English and the Spanish ids differ, and `id` is a structural attribute the
 * parity gate compares between twins.
 *
 * A span rather than a div: Starlight spaces content blocks with a selector
 * that skips spans, so the alias adds no gap of its own
 * (src/styles/components.css keeps the gap of whatever follows it).
 */
interface Props {
	name: string;
}

const { name } = Astro.props;
if (typeof name !== "string" || !/^[^\s#"'<>&]+$/u.test(name)) {
	throw new Error(
		`Anchor: name must be the published id, without "#" and without spaces, got "${String(name)}"`,
	);
}
---

<span id={name} data-anchor-alias></span>
