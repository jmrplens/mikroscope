---
/**
 * The InfluxDB dashboard, section by section, as it renders against a store
 * with data in it.
 *
 * The captures are generated rather than taken by hand:
 * `site/scripts/gen-dashboard-captures.mjs` drives a real Grafana over a
 * demonstration database that `test/e2e/docker`'s TestFillStoreForCaptures
 * fills with a run of the same canned fake agent the end-to-end suites use.
 * Nothing about a real router is in them, and the header of that script says
 * how to regenerate the set.
 *
 * Each file is named `<index>-<section slug>.webp`, and the section titles
 * come from the committed dashboard (src/data/dashboards.ts), so a section
 * renamed by `dashboards gen` renames its caption here — and a section with no
 * capture, or a capture with no section, is visible as a gap rather than
 * silently dropped.
 *
 * The files are 1600 px wide, twice the 50rem prose column, and a plain `<img>`
 * sent all 1600 px to every reader, a phone included. `<Image>` writes a 640,
 * a 1024 and a 1600 px variant and lets the browser pick one through `srcset`
 * and `sizes`; the link around each still opens the committed file at full
 * size, because a section is read by zooming into it. Capture.astro uses the
 * same widths and sizes, so change the two together.
 *
 * The 21 captures on the built /dashboards/ page, 2026-09-24: before, every
 * reader got the same 1 214 KiB, the sum of the files; after, as fetched by
 * Chromium, 313 KiB on a 390 px screen at 1x, 607 KiB on a 1440 px one at 1x,
 * and 1 207 KiB where the pixel density asks for the 1600 px variants anyway
 * (1440 px at 2x, 390 px at 3x).
 */
import { Image } from "astro:assets";
import { countOf, sectionNames } from "../data/dashboards";
import { langOf } from "../lib/lang";

const images = import.meta.glob<{ default: ImageMetadata }>(
	"../assets/dashboards/*.webp",
	{ eager: true },
);

/** The variants written for `srcset`; the largest is the committed file's own width. */
const WIDTHS = [640, 1024, 1600];
/** At most the prose column (`--sl-content-width`, 50rem in chrome.css), else the viewport. */
const SIZES = "(min-width: 50rem) 50rem, 100vw";

/** `Memory and load` → `memory-and-load`, the slug the generator writes. */
const slug = (title: string) =>
	title
		.toLowerCase()
		.replaceAll(/[^a-z0-9]+/g, "-")
		.replaceAll(/^-|-$/g, "");

const bySlug = new Map(
	Object.entries(images).map(([file, module]) => [
		/\d+-(.+)\.webp$/.exec(file)?.[1] ?? file,
		module.default,
	]),
);

const lang = langOf(Astro.locals.starlightRoute) === "es" ? "es" : "en";
const strings = {
	en: {
		panels: (n: number) => `${n} panels`,
		alt: (title: string, n: number) =>
			`The "${title}" section of the InfluxDB dashboard, ${n} panels, rendered over the demonstration database`,
	},
	es: {
		panels: (n: number) => `${n} paneles`,
		alt: (title: string, n: number) =>
			`La sección «${title}» del dashboard de InfluxDB, ${n} paneles, dibujada sobre la base de demostración`,
	},
}[lang];

const sections = sectionNames
	.map((title) => ({
		title,
		image: bySlug.get(slug(title)),
		panels: countOf("influxdb", title) ?? 0,
	}))
	.filter((s) => s.image);
---

<div class="ms-captures">
	{
		sections.map(({ title, image, panels }) => (
			<figure class="ms-capture">
				<a href={image!.src}>
					<Image
						src={image!}
						widths={WIDTHS}
						sizes={SIZES}
						width={image!.width}
						height={image!.height}
						loading="lazy"
						decoding="async"
						alt={strings.alt(title, panels)}
					/>
				</a>
				<figcaption>
					<strong>{title}</strong> — {strings.panels(panels)}
				</figcaption>
			</figure>
		))
	}
</div>
