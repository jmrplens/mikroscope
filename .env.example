# mikroscope — environment template. Copy to .env and fill in what you use:
#
#   cp .env.example .env && $EDITOR .env
#   set -a; . ./.env; set +a
#
# .env is gitignored. Every name below is read by the CLI (cmd/mikroscope,
# env()); flags override the environment, and the full list with defaults is
# in the documentation under Reference → Environment.

# ── The router ─────────────────────────────────────────────────────────────
# ssh target for the deployment verbs (doctor, plan, install, status, upgrade,
# uninstall). user@host, or an alias from ~/.ssh/config.
MIKROSCOPE_ROUTER=admin@192.168.88.1
MIKROSCOPE_SSH_PORT=22
MIKROSCOPE_SSH_KEY=
# Extra ssh and scp options, comma-separated Key=value pairs, from a fixed set:
# StrictHostKeyChecking, UserKnownHostsFile, ConnectTimeout, HostKeyAlgorithms,
# PubkeyAcceptedAlgorithms, IdentitiesOnly, ServerAliveInterval. The CLI runs
# ssh in batch mode, which refuses a host key not yet in known_hosts;
# StrictHostKeyChecking=accept-new records it on the first connect.
#MIKROSCOPE_SSH_OPTIONS=StrictHostKeyChecking=accept-new
# Device architecture: arm64 (most container-capable boards), arm (32-bit
# RouterOS, the hEX refresh line), amd64 (CHR, x86) or auto. Unset is auto:
# doctor, install and upgrade read it from the router; plan, --dry-run and
# image, which connect to nothing, take arm64.
#MIKROSCOPE_ARCH=auto

# Where the agent image comes from. Leave both empty to have the CLI build the
# agent with a local Go toolchain from a checkout; set one of them to install
# from a release instead.
#MIKROSCOPE_AGENT_TAR=mikroscope-agent-arm64.tar
#MIKROSCOPE_REMOTE_IMAGE=ghcr.io/jmrplens/mikroscope-agent:1.0.0

# ── RouterOS API ───────────────────────────────────────────────────────────
# The binary API (port 8728) feeds the collector's API tier, `--log-markers`
# and the fetch relay. Give it its own read-only user; `test` is what /tool
# fetch needs and nothing here needs write:
#   /user/group/add name=mikroscope policy=read,api,test,!write,!ftp,!local,!telnet,!ssh,!reboot,!policy,!winbox,!password,!web,!sniff,!sensitive,!romon,!rest-api
#   /user/add name=mikroscope group=mikroscope password=<generate one>
MIKROSCOPE_API_ADDR=192.168.88.1:8728
MIKROSCOPE_API_USER=mikroscope
MIKROSCOPE_API_PASSWORD=

# ── What install writes on the router ──────────────────────────────────────
# Unset, install uses the value shown, and uninstall, status and upgrade take
# the one the install on the router was made with, which they read from its
# install manifest, or from its tagged objects for an install that has none.
# A value set here that the install contradicts is refused, naming both.
#
# The interface list the veth joins, which must exist on the router, and the
# address list the /30 joins, which the /30 creates when it has no entry yet.
# none joins no list; doctor says whether the firewall needs either.
#MIKROSCOPE_IFACE_LIST=LAN
#MIKROSCOPE_ADDR_LIST=LANs
# A free point-to-point /30 for the container, and the veth's name. Pick a /30
# nothing else on the router uses; doctor names a route it overlaps.
#MIKROSCOPE_SUBNET=172.30.10.0/30
#MIKROSCOPE_VETH=veth-mikroscope
#MIKROSCOPE_NAME=mikroscope          # container name; tags every object it creates
#MIKROSCOPE_DISK=tmpfs               # image and root on the RAM disk: no flash writes
# The bearer token the agent requires; mandatory for install, upgrade and plan
# with --expose. The CLI hands the command that writes it to ssh on standard
# input, never on a command line, and reading it from here keeps it off the
# CLI's own command line too.
#MIKROSCOPE_TOKEN=
#MIKROSCOPE_LAN_ADDRESS=192.168.88.1 # router LAN address, for --expose

# ── Collector sinks (forward) ──────────────────────────────────────────────
# Each sink also has a flag; these are the defaults it reads.
#MIKROSCOPE_HOST_TAG=rb5009          # the host tag on every row
#MIKROSCOPE_INTERFACES=bridge,ether1 # which interfaces the API tier monitors
# InfluxDB 3: the server and the database, and forward assembles the write URL.
#MIKROSCOPE_INFLUX_URL=http://influx.example:8181
#MIKROSCOPE_INFLUX_DB=mikroscope
#MIKROSCOPE_INFLUX_TOKEN=
# A full write URL is still taken verbatim, for a v2 endpoint or an existing
# deployment. Quote it — an unquoted & is a shell operator when this file is
# sourced — and note that a URL this cannot take apart cannot describe a
# Grafana datasource for `forward --grafana`.
#MIKROSCOPE_INFLUX_URL="http://influx.example:8181/api/v3/write_lp?db=mikroscope&precision=nanosecond"
#MIKROSCOPE_LOKI_URL=http://loki.example:3100
#MIKROSCOPE_OTLP_URL=http://otel.example:4318
# PostgreSQL, for the sink that connects (--postgres). The file sink (--sql)
# needs nothing here. A password on the command line is visible in `ps`: leave
# it out of the DSN and let pgx read ~/.pgpass or PGPASSWORD, as psql does.
#MIKROSCOPE_POSTGRES_DSN=postgres://mikroscope@db.example/mikroscope?sslmode=require
#MIKROSCOPE_ELASTIC_URL=http://elastic.example:9200
#MIKROSCOPE_GRAPHITE_ADDR=graphite.example:2003
#MIKROSCOPE_TELEGRAF_URL=http://telegraf.example:8186
# Tokens and tenants the push sinks send, where the receiver wants one.
#MIKROSCOPE_LOKI_TOKEN=
#MIKROSCOPE_LOKI_TENANT=
#MIKROSCOPE_OTLP_TOKEN=
#MIKROSCOPE_ELASTIC_AUTH=
#MIKROSCOPE_TELEGRAF_TOKEN=

# ── Grafana, for `mikroscope dashboards import|check` ──────────────────────
# import and check read GRAFANA_URL, then MIKROSCOPE_GRAFANA_URL below;
# `dashboards publish` and `uninstall` read the two the other way round.
#GRAFANA_URL=http://grafana.example:3000
#GRAFANA_TOKEN=

# ── Grafana, for `forward --grafana` and `dashboards publish` ───────────────
# forward publishes at start, and is off unless MIKROSCOPE_GRAFANA_URL or
# --grafana is set: it never reads the unprefixed GRAFANA_URL. The token is
# GRAFANA_TOKEN above, the same one. These carry the prefix because they are
# the collector's settings, which `dashboards publish` shares.
#MIKROSCOPE_GRAFANA_URL=http://grafana.example:3000
#MIKROSCOPE_GRAFANA_FOLDER=mikroscope
# One datasource, so one store: a run with more than one store that sets
# either of the next two is refused. Run `dashboards publish` once per store.
#MIKROSCOPE_GRAFANA_DATASOURCE_UID= # adopt one instead of creating it
# The address Grafana queries. --prom is scraped and --graphite speaks its
# ingest port, so neither can know it; the other three derive theirs.
#MIKROSCOPE_GRAFANA_DATASOURCE_URL=http://prometheus.example:9090
#MIKROSCOPE_GRAFANA_DATASOURCE_SSLMODE= # disable|require|verify-ca|verify-full
