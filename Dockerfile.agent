# The agent image GoReleaser publishes: FROM scratch, one static binary,
# nothing else. It compiles nothing: the binary it copies is the one the agent
# archives of the same release carry, already stamped, so the image and the
# archive cannot disagree about what they contain. `mikroscope install` builds
# the same image as a tar without Docker (internal/image).
#
# TARGETPLATFORM is how GoReleaser's dockers_v2 lays the build context out: one
# directory per platform, each holding that platform's binary.
#
# There is no LABEL block here. GoReleaser passes the OCI labels on the build
# command line from .goreleaser.yaml, where the version, the commit and the
# date are known.
FROM scratch
ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/mikroscope-agent /mikroscope-agent
ENTRYPOINT ["/mikroscope-agent"]
