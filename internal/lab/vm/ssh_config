# The lab router, as seen from inside the lab's network namespace: the lab
# container itself and every `mikroscope-lab cli` run, which share it. Host
# keys are not pinned: the router lives on a tap inside that namespace, which
# takes no connection from other containers (vm-boot's firewall), it is
# re-provisioned from scratch at will, and a stale known_hosts entry would be
# the lab's most common failure and never a real one.
Host lab
	HostName 192.168.88.1
	User admin
	IdentityFile ~/.ssh/id_ed25519
	IdentitiesOnly yes
	StrictHostKeyChecking no
	UserKnownHostsFile /dev/null
	LogLevel ERROR
	ConnectTimeout 10

# The same router over ether1, through QEMU's forward: the first boot, before
# ether2 has an address, and the way back in after a test broke the LAN side.
Host lab-wan
	HostName 127.0.0.1
	Port 10022
	User admin
	IdentityFile ~/.ssh/id_ed25519
	IdentitiesOnly yes
	StrictHostKeyChecking no
	UserKnownHostsFile /dev/null
	LogLevel ERROR
	ConnectTimeout 10

# Any other host is refused before a connection is made. Nothing that runs in
# the lab's namespace (mikroscope-lab, `mikroscope-lab cli`) has a reason to
# open ssh to anything but the lab router, so a --router or a
# MIKROSCOPE_ROUTER that named another router stops here, and never asks for
# a password.
Host * !lab !lab-wan
	BatchMode yes
	ProxyCommand sh -c 'echo "lab: ssh from the lab reaches the lab router only (Host lab and lab-wan)" >&2; exit 1'
